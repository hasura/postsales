FROM us-docker.pkg.dev/hasura-container-images/external-images/docker.io/library/node:16-alpine-stable as build-step
WORKDIR /app
ENV PATH /app/node_modules/.bin:$PATH
COPY package.json ./
COPY ./src ./src
COPY ./public ./public
RUN npm install
RUN npm run build

# Build step #2: build an nginx container
FROM us-docker.pkg.dev/hasura-container-images/external-images/docker.io/library/nginx:stable-alpine-stable
COPY --from=build-step /app/build /usr/share/nginx/html
COPY deployment/nginx.default.conf /etc/nginx/conf.d/default.conf